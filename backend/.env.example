PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# PFZ Configuration
# ---------------------------------------------------------------------------
PFZ_TIMEOUT_MS=4000
PFZ_SST_SOURCE=open-meteo
PFZ_CHLOROPHYLL_SOURCE=baseline
PFZ_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Supabase (backend-only — never prefix with VITE_)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:YourPassword@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# INCOIS ERDDAP
# ---------------------------------------------------------------------------
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap
INCOIS_TIMEOUT_MS=4000
INCOIS_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Groq
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Phase 1 — Nominatim geocoding proxy
# ---------------------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ORCA-Marine-App/1.0 (https://github.com/Krushnakedar/Orca_Final_Sih; contact@example.com)
NOMINATIM_EMAIL=contact@example.com

# ---------------------------------------------------------------------------
# Phase 1 — AISStream live vessel feed (backend-only)
# ---------------------------------------------------------------------------
AISSTREAM_API_KEY=your_aisstream_api_key
AISSTREAM_BOUNDS=[[5.0,65.0],[25.0,95.0]]

# ---------------------------------------------------------------------------
# Phase 1 — Geospatial provider selection
# Set to "true" only for offline tests. Never in production.
# ---------------------------------------------------------------------------
GEOSPATIAL_USE_MOCK=false